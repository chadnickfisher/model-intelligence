{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "research-scope-run.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "id": {
      "type": "string"
    },
    "contract_id": {
      "const": "research-scope-v1"
    },
    "contract_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "base_commit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "baseline_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "rubric_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "created_at": {
      "type": "string",
      "format": "date"
    },
    "subjects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": {
            "enum": [
              "model",
              "provider",
              "product",
              "discovery"
            ]
          },
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "operation": {
            "enum": [
              "review",
              "onboard",
              "resolve"
            ]
          },
          "identity": {
            "anyOf": [
              {
                "$ref": "discovery-identity.schema.json"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "kind",
          "id",
          "operation",
          "identity"
        ]
      }
    },
    "bounds": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_minutes_per_subject": {
          "type": "integer",
          "minimum": 1
        },
        "max_searches_per_subject": {
          "type": "integer",
          "minimum": 1
        },
        "source_categories": {
          "type": "array",
          "items": {
            "enum": [
              "primary",
              "independent_evaluation",
              "practitioner"
            ]
          }
        }
      },
      "required": [
        "max_minutes_per_subject",
        "max_searches_per_subject",
        "source_categories"
      ]
    },
    "domain_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "subject_kind": {
            "enum": [
              "model",
              "provider",
              "product",
              "discovery"
            ]
          },
          "subject_id": {
            "type": "string"
          },
          "domain": {
            "type": "string"
          },
          "result": {
            "enum": [
              "not_checked",
              "blocked",
              "unknown",
              "value",
              "checked",
              "changed",
              "unchanged",
              "excluded",
              "assessed",
              "not_applicable"
            ]
          },
          "checked_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "rationale": {
            "type": "string"
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "search_references": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "query": {
                  "type": "string",
                  "minLength": 1
                },
                "checked_at": {
                  "type": "string",
                  "format": "date"
                },
                "outcome": {
                  "enum": [
                    "sources_located",
                    "no_matched_sources",
                    "blocked"
                  ]
                },
                "urls": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "notes": {
                  "type": "string"
                }
              },
              "required": [
                "query",
                "checked_at",
                "outcome",
                "urls",
                "notes"
              ]
            }
          },
          "conditions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "remaining_gaps": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "blocked_reason": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "subject_kind",
          "subject_id",
          "domain",
          "result",
          "checked_at",
          "rationale",
          "evidence_ids",
          "search_references",
          "conditions",
          "remaining_gaps",
          "blocked_reason"
        ]
      }
    },
    "field_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "subject_kind": {
            "enum": [
              "model",
              "provider",
              "product",
              "discovery"
            ]
          },
          "subject_id": {
            "type": "string"
          },
          "domain": {
            "type": "string"
          },
          "entity_type": {
            "type": "string"
          },
          "entity_id": {
            "type": "string"
          },
          "path": {
            "type": "string",
            "pattern": "^/"
          },
          "baseline_value_hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "result": {
            "enum": [
              "not_checked",
              "blocked",
              "unknown",
              "value",
              "checked",
              "changed",
              "unchanged",
              "excluded",
              "assessed",
              "not_applicable"
            ]
          },
          "checked_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "rationale": {
            "type": "string"
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "search_references": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "query": {
                  "type": "string",
                  "minLength": 1
                },
                "checked_at": {
                  "type": "string",
                  "format": "date"
                },
                "outcome": {
                  "enum": [
                    "sources_located",
                    "no_matched_sources",
                    "blocked"
                  ]
                },
                "urls": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "notes": {
                  "type": "string"
                }
              },
              "required": [
                "query",
                "checked_at",
                "outcome",
                "urls",
                "notes"
              ]
            }
          },
          "conditions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "remaining_gaps": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "blocked_reason": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "subject_kind",
          "subject_id",
          "domain",
          "entity_type",
          "entity_id",
          "path",
          "baseline_value_hash",
          "result",
          "checked_at",
          "rationale",
          "evidence_ids",
          "search_references",
          "conditions",
          "remaining_gaps",
          "blocked_reason"
        ]
      }
    },
    "task_decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "model_id": {
            "type": "string"
          },
          "task_id": {
            "type": "string"
          },
          "applicability": {
            "enum": [
              "not_checked",
              "applicable",
              "excluded",
              "unknown"
            ]
          },
          "judgment_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "confidence_rationale": {
            "type": "string"
          },
          "result": {
            "enum": [
              "not_checked",
              "blocked",
              "unknown",
              "value",
              "checked",
              "changed",
              "unchanged",
              "excluded",
              "assessed",
              "not_applicable"
            ]
          },
          "checked_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "rationale": {
            "type": "string"
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "search_references": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "query": {
                  "type": "string",
                  "minLength": 1
                },
                "checked_at": {
                  "type": "string",
                  "format": "date"
                },
                "outcome": {
                  "enum": [
                    "sources_located",
                    "no_matched_sources",
                    "blocked"
                  ]
                },
                "urls": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "notes": {
                  "type": "string"
                }
              },
              "required": [
                "query",
                "checked_at",
                "outcome",
                "urls",
                "notes"
              ]
            }
          },
          "conditions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "remaining_gaps": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "blocked_reason": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "model_id",
          "task_id",
          "applicability",
          "judgment_ids",
          "confidence_rationale",
          "result",
          "checked_at",
          "rationale",
          "evidence_ids",
          "search_references",
          "conditions",
          "remaining_gaps",
          "blocked_reason"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "result": {
                  "const": "excluded"
                }
              },
              "required": [
                "result"
              ]
            },
            "then": {
              "properties": {
                "judgment_ids": {
                  "maxItems": 0
                },
                "applicability": {
                  "const": "excluded"
                }
              }
            }
          }
        ]
      }
    },
    "source_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "subject_kind": {
            "enum": [
              "model",
              "provider",
              "product",
              "discovery"
            ]
          },
          "subject_id": {
            "type": "string"
          },
          "category": {
            "enum": [
              "primary",
              "independent_evaluation",
              "practitioner"
            ]
          },
          "result": {
            "enum": [
              "not_checked",
              "blocked",
              "unknown",
              "value",
              "checked",
              "changed",
              "unchanged",
              "excluded",
              "assessed",
              "not_applicable"
            ]
          },
          "checked_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "rationale": {
            "type": "string"
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "search_references": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "query": {
                  "type": "string",
                  "minLength": 1
                },
                "checked_at": {
                  "type": "string",
                  "format": "date"
                },
                "outcome": {
                  "enum": [
                    "sources_located",
                    "no_matched_sources",
                    "blocked"
                  ]
                },
                "urls": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "notes": {
                  "type": "string"
                }
              },
              "required": [
                "query",
                "checked_at",
                "outcome",
                "urls",
                "notes"
              ]
            }
          },
          "conditions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "remaining_gaps": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "blocked_reason": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "subject_kind",
          "subject_id",
          "category",
          "result",
          "checked_at",
          "rationale",
          "evidence_ids",
          "search_references",
          "conditions",
          "remaining_gaps",
          "blocked_reason"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "id",
    "contract_id",
    "contract_hash",
    "base_commit",
    "baseline_hash",
    "rubric_hash",
    "created_at",
    "subjects",
    "bounds",
    "domain_checks",
    "field_checks",
    "task_decisions",
    "source_checks"
  ]
}
