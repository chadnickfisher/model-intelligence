{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "release-record.schema.json",
  "title": "release-record",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "verified_at": {
      "type": "string",
      "format": "date"
    },
    "model_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "provider_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "event_type": {
      "type": "string"
    },
    "event_date": {
      "type": [
        "string",
        "null"
      ]
    },
    "summary": {
      "type": "string"
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(src|obs)-[a-f0-9]{12}$"
      },
      "uniqueItems": true
    },
    "model_label": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "schema_version",
    "id",
    "verified_at",
    "model_id",
    "provider_id",
    "event_type",
    "event_date",
    "summary",
    "evidence_ids",
    "model_label"
  ],
  "additionalProperties": false
}
