{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "source-record.schema.json",
  "title": "source-record",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^(src|obs)-[a-f0-9]{12}$"
    },
    "url": {
      "type": "string",
      "format": "uri"
    },
    "title": {
      "type": [
        "string",
        "null"
      ]
    },
    "publisher": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_type": {
      "enum": [
        "primary",
        "independent-evaluation",
        "practitioner",
        "secondary",
        "unknown"
      ]
    },
    "published_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "accessed_at": {
      "type": "string",
      "format": "date"
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "claim_scope": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "snapshots": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^snapshot-[a-f0-9]{20}$"
          },
          "original": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "bytes": {
                "type": "integer",
                "minimum": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "bytes",
              "sha256"
            ]
          },
          "readable": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "bytes": {
                "type": "integer",
                "minimum": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "bytes",
              "sha256"
            ]
          },
          "final_url": {
            "type": "string",
            "format": "uri"
          },
          "retrieval_started_at": {
            "type": "string",
            "format": "date-time"
          },
          "retrieval_completed_at": {
            "type": "string",
            "format": "date-time"
          },
          "extractor_version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 3000
          },
          "publication_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "effective_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "original",
          "readable",
          "final_url",
          "retrieval_started_at",
          "retrieval_completed_at",
          "extractor_version",
          "publication_at",
          "effective_at"
        ]
      }
    }
  },
  "required": [
    "id",
    "url",
    "title",
    "publisher",
    "source_type",
    "published_at",
    "accessed_at",
    "limitations",
    "claim_scope"
  ],
  "additionalProperties": false
}
