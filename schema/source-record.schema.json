{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "source-record.schema.json",
  "title": "source-record",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^(src|obs)-[a-f0-9]{12}$"
    },
    "url": {
      "type": "string",
      "format": "uri"
    },
    "title": {
      "type": [
        "string",
        "null"
      ]
    },
    "publisher": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_type": {
      "enum": [
        "primary",
        "independent-evaluation",
        "practitioner",
        "secondary",
        "unknown"
      ]
    },
    "published_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "accessed_at": {
      "type": "string",
      "format": "date"
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "claim_scope": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "id",
    "url",
    "title",
    "publisher",
    "source_type",
    "published_at",
    "accessed_at",
    "limitations",
    "claim_scope"
  ],
  "additionalProperties": false
}
