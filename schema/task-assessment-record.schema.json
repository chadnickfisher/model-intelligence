{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Current task assessment",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^task-assessment-[a-f0-9]{16}$"
    },
    "model_id": {
      "type": "string"
    },
    "task_id": {
      "type": "string"
    },
    "applicability": {
      "enum": [
        "applicable",
        "excluded",
        "unknown"
      ]
    },
    "result": {
      "enum": [
        "assessed",
        "excluded",
        "unknown"
      ]
    },
    "checked_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    },
    "confidence_rationale": {
      "type": "string"
    },
    "judgment_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "conditions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "aggregate": {
      "oneOf": [
        {
          "description": "Explicit policy-v1 task suitability; absence means no aggregate has been assigned. Never infer it from legacy finding labels.",
          "type": "object",
          "properties": {
            "policy_version": {
              "const": "1"
            },
            "suitability": {
              "enum": [
                "high",
                "medium",
                "low",
                "not_supported",
                "disputed",
                "unknown"
              ]
            },
            "evidence_confidence": {
              "enum": [
                "high",
                "medium",
                "low",
                null
              ]
            },
            "assessed_at": {
              "type": "string",
              "format": "date"
            },
            "rationale": {
              "type": "string",
              "pattern": "\\S"
            },
            "confidence_rationale": {
              "type": "string",
              "pattern": "\\S"
            },
            "supporting_evidence_ids": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "uniqueItems": true
            },
            "contradictory_evidence_ids": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "uniqueItems": true
            },
            "conflict_rationale": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "string",
                  "pattern": "\\S"
                }
              ]
            },
            "watch_outs": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "\\S"
              },
              "uniqueItems": true
            },
            "access_ids": {
              "description": "Assessed access routes; empty for a native or unspecified route, which must be explained in conditions.",
              "type": "array",
              "items": {
                "type": "string"
              },
              "uniqueItems": true
            }
          },
          "required": [
            "policy_version",
            "suitability",
            "evidence_confidence",
            "assessed_at",
            "rationale",
            "confidence_rationale",
            "supporting_evidence_ids",
            "contradictory_evidence_ids",
            "conflict_rationale",
            "watch_outs",
            "access_ids"
          ],
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "properties": {
                  "suitability": {
                    "enum": [
                      "disputed",
                      "unknown"
                    ]
                  }
                }
              },
              "then": {
                "properties": {
                  "evidence_confidence": {
                    "const": null
                  }
                }
              },
              "else": {
                "properties": {
                  "evidence_confidence": {
                    "enum": [
                      "high",
                      "medium",
                      "low"
                    ]
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "suitability": {
                    "const": "disputed"
                  }
                }
              },
              "then": {
                "properties": {
                  "conflict_rationale": {
                    "type": "string",
                    "pattern": "\\S"
                  },
                  "contradictory_evidence_ids": {
                    "minItems": 1
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "suitability": {
                    "not": {
                      "const": "unknown"
                    }
                  }
                }
              },
              "then": {
                "properties": {
                  "supporting_evidence_ids": {
                    "minItems": 1
                  }
                }
              }
            }
          ]
        },
        {
          "description": "Explicit policy-v1 task suitability; absence means no aggregate has been assigned. Never infer it from legacy finding labels.",
          "type": "object",
          "properties": {
            "policy_version": {
              "const": "2"
            },
            "suitability": {
              "enum": [
                "high",
                "medium",
                "low",
                "not_supported",
                "disputed",
                "unknown"
              ]
            },
            "evidence_confidence": {
              "enum": [
                "high",
                "medium",
                "low",
                null
              ]
            },
            "assessed_at": {
              "type": [
                "string",
                "null"
              ],
              "format": "date"
            },
            "rationale": {
              "type": "string",
              "pattern": "\\S"
            },
            "confidence_rationale": {
              "type": "string",
              "pattern": "\\S"
            },
            "supporting_evidence_ids": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "uniqueItems": true
            },
            "contradictory_evidence_ids": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "uniqueItems": true
            },
            "conflict_rationale": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "string",
                  "pattern": "\\S"
                }
              ]
            },
            "watch_outs": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "\\S"
              },
              "uniqueItems": true
            },
            "access_ids": {
              "description": "Assessed access routes; empty for a native or unspecified route, which must be explained in conditions.",
              "type": "array",
              "items": {
                "type": "string"
              },
              "uniqueItems": true
            },
            "basis": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "enum": [
                    "direct_evaluation",
                    "reported_experience",
                    "vendor_documentation",
                    "reasoned_inference",
                    "mixed",
                    "unknown"
                  ]
                },
                "rationale": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 3000
                }
              },
              "required": [
                "kind",
                "rationale"
              ]
            },
            "inspection_reported_at": {
              "type": [
                "string",
                "null"
              ],
              "format": "date-time"
            },
            "recorded_at": {
              "type": "string",
              "format": "date-time"
            },
            "snapshot_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9._-]{0,159}$"
              },
              "uniqueItems": true,
              "maxItems": 30
            },
            "positive_boundary": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "description": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 3000
                    },
                    "source_ids": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "pattern": "^[a-z0-9][a-z0-9._-]{0,159}$"
                      },
                      "uniqueItems": true,
                      "maxItems": 30,
                      "minItems": 1
                    }
                  },
                  "required": [
                    "description",
                    "source_ids"
                  ]
                }
              ]
            }
          },
          "required": [
            "policy_version",
            "suitability",
            "evidence_confidence",
            "assessed_at",
            "rationale",
            "confidence_rationale",
            "supporting_evidence_ids",
            "contradictory_evidence_ids",
            "conflict_rationale",
            "watch_outs",
            "access_ids",
            "basis",
            "inspection_reported_at",
            "recorded_at",
            "snapshot_ids",
            "positive_boundary"
          ],
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "properties": {
                  "suitability": {
                    "enum": [
                      "disputed",
                      "unknown"
                    ]
                  }
                }
              },
              "then": {
                "properties": {
                  "evidence_confidence": {
                    "const": null
                  }
                }
              },
              "else": {
                "properties": {
                  "evidence_confidence": {
                    "enum": [
                      "high",
                      "medium",
                      "low"
                    ]
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "suitability": {
                    "const": "disputed"
                  }
                }
              },
              "then": {
                "properties": {
                  "conflict_rationale": {
                    "type": "string",
                    "pattern": "\\S"
                  },
                  "contradictory_evidence_ids": {
                    "minItems": 1
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "suitability": {
                    "not": {
                      "const": "unknown"
                    }
                  }
                }
              },
              "then": {
                "properties": {
                  "supporting_evidence_ids": {
                    "minItems": 1
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "suitability": {
                    "const": "not_supported"
                  }
                }
              },
              "then": {
                "properties": {
                  "positive_boundary": {
                    "type": "object"
                  }
                }
              }
            }
          ]
        }
      ]
    },
    "remaining_gaps": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    }
  },
  "required": [
    "id",
    "model_id",
    "task_id",
    "applicability",
    "result",
    "checked_at",
    "rationale",
    "confidence_rationale",
    "judgment_ids",
    "evidence_ids",
    "conditions",
    "remaining_gaps"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "required": [
          "aggregate"
        ]
      },
      "then": {
        "properties": {
          "conditions": {
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "\\S"
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "aggregate": {
                  "properties": {
                    "suitability": {
                      "const": "not_supported"
                    }
                  }
                }
              }
            },
            "then": {
              "properties": {
                "applicability": {
                  "const": "excluded"
                },
                "result": {
                  "const": "excluded"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "aggregate": {
                  "properties": {
                    "suitability": {
                      "const": "unknown"
                    }
                  }
                }
              }
            },
            "then": {
              "properties": {
                "applicability": {
                  "enum": [
                    "applicable",
                    "unknown"
                  ]
                },
                "result": {
                  "const": "unknown"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "aggregate": {
                  "properties": {
                    "suitability": {
                      "enum": [
                        "high",
                        "medium",
                        "low",
                        "disputed"
                      ]
                    }
                  }
                }
              }
            },
            "then": {
              "properties": {
                "applicability": {
                  "const": "applicable"
                },
                "result": {
                  "const": "assessed"
                }
              }
            }
          }
        ]
      }
    },
    {
      "if": {
        "required": [
          "aggregate"
        ],
        "properties": {
          "aggregate": {
            "required": [
              "policy_version"
            ],
            "properties": {
              "policy_version": {
                "const": "2"
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "checked_at": {
            "type": "string"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "result": {
            "const": "excluded"
          }
        },
        "required": [
          "result"
        ]
      },
      "then": {
        "properties": {
          "judgment_ids": {
            "maxItems": 0
          },
          "applicability": {
            "const": "excluded"
          }
        }
      }
    }
  ]
}
