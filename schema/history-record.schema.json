{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["id", "entity_type", "entity_id", "canonical_path", "observed_at", "effective_from", "operation", "previous_revision_id", "reason", "evidence_ids", "value"],
  "properties": {
    "id": {"type": "string", "pattern": "^revision-[a-f0-9]{20}$"},
    "entity_type": {"enum": ["model", "provider", "price", "access", "release", "source", "observation", "task", "alias"]},
    "entity_id": {"type": "string"},
    "canonical_path": {"type": "string"},
    "observed_at": {"type": "string", "format": "date"},
    "effective_from": {"type": ["string", "null"], "format": "date"},
    "operation": {"enum": ["baseline", "update", "remove"]},
    "previous_revision_id": {"type": ["string", "null"]},
    "reason": {"type": "string", "minLength": 1},
    "evidence_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "value": {"type": ["object", "null"]}
  },
  "additionalProperties": false
}
