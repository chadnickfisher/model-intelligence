{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^benchmark-[a-f0-9]{16}$"
    },
    "model_id": {
      "type": "string"
    },
    "judgment_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "benchmark": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": [
            "string",
            "null"
          ]
        },
        "metric": {
          "type": "string"
        },
        "unit": {
          "type": "string"
        },
        "direction": {
          "enum": [
            "higher",
            "lower",
            "none",
            "unknown"
          ]
        }
      },
      "required": [
        "name",
        "version",
        "metric",
        "unit",
        "direction"
      ],
      "additionalProperties": false
    },
    "value": {
      "type": [
        "number",
        "string",
        "null"
      ]
    },
    "model_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "harness": {
      "type": [
        "string",
        "null"
      ]
    },
    "effort": {
      "type": [
        "string",
        "null"
      ]
    },
    "provider_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "tools": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      }
    },
    "measured_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "observed_at": {
      "type": "string",
      "format": "date"
    },
    "evidence_class": {
      "enum": [
        "independent_quality",
        "preference",
        "vendor_claim",
        "practitioner_test",
        "unknown"
      ]
    },
    "source_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "conditions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "evidence_notes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "id",
    "model_id",
    "judgment_ids",
    "benchmark",
    "value",
    "model_version",
    "harness",
    "effort",
    "provider_id",
    "tools",
    "measured_at",
    "observed_at",
    "evidence_class",
    "source_ids",
    "conditions",
    "limitations",
    "evidence_notes"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "benchmark-record.schema.json",
  "title": "benchmark-record"
}
